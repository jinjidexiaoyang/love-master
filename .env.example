# 恋爱大师 配置示例
# 复制此文件为 .env 并填入真实值，.env 不应提交到版本控制。
# 提示：也可以不用 .env —— 直接在应用「⚙ 设置」页里填写并保存即可（.env 优先级更高）。

# ─── Anthropic / Claude ───────────────────────────────────────
ANTHROPIC_API_KEY=
# 中转站 base_url（留空则走官方端点）
ANTHROPIC_BASE_URL=
# 默认：claude-opus-4-5
ANTHROPIC_MODEL=
# 请求超时秒数，默认 120
ANTHROPIC_TIMEOUT=

# ─── DeepSeek ────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# 默认：https://api.deepseek.com
DEEPSEEK_BASE_URL=
# 默认：deepseek-chat
DEEPSEEK_MODEL=
# 请求超时秒数，默认 120
DEEPSEEK_TIMEOUT=

# ─── 管理端 ──────────────────────────────────────────────────
# 留空则管理后台进入无口令调试模式（生产环境必须设置）
LOVE_MASTER_ADMIN_TOKEN=

# ─── 通用 ────────────────────────────────────────────────────
# 默认通用超时（秒），默认 30
DEFAULT_REQUEST_TIMEOUT=
